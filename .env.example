# =====================================================================
#  Variables du site Dolina Darts Club — MODÈLE (sans secret)
#  Copier en « .env » pour un usage local : cp .env.example .env
#  Le fichier .env est ignoré par Git (.gitignore) : ne jamais le publier.
#
#  Important : le site lui-même est statique et ne lit PAS ce fichier.
#  Sa configuration publique est dans assets/js/config.js.
# =====================================================================

# --- Supabase (valeurs PUBLIQUES, déjà visibles dans assets/js/config.js) ---
SUPABASE_URL=https://zygebzwobnxutowiqgxk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ZIj8arAEEmcIgp3EguWCzw_Uxc2szqz
# Clé secrète (sb_secret_… / service_role) : JAMAIS ici, ni dans le dépôt, ni dans une conversation.

# --- Options du site (reflet de config.js) ---
EMAILS_ACTIFS=false
EMAIL_CLUB=dolinadartsclub@gmail.com

# --- Script outils/generer-partage.mjs (aperçus de partage des articles) ---
# Adresse publique du site (à changer lors de la migration vers dolina.mydarts.org)
SITE_URL=https://dolinadartsclub.github.io/Site_Dolina/
# Remplies automatiquement par GitHub Actions, utiles seulement pour un test local :
# EVENEMENT=push            # « schedule » = passage automatique toutes les 15 min
# GITHUB_SHA=local123       # numéro de version (sinon l'heure courante)
# GITHUB_OUTPUT=            # fichier de sortie d'Actions (laisser vide en local)

# --- Base de test locale (outils/test-base) ---
PGHOST=/tmp
PGPORT=5499
PGUSER=postgres
PGDATABASE=dt

# --- Déploiement FTP éventuel vers dolina.mydarts.org ---
# À créer UNIQUEMENT comme secrets GitHub (Settings › Secrets and variables › Actions),
# jamais dans ce fichier rempli ni dans le dépôt :
# FTP_SERVEUR=
# FTP_UTILISATEUR=
# FTP_MOT_DE_PASSE=
# FTP_DOSSIER=
